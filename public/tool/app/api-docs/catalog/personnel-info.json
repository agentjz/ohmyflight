{
  "schemaVersion": 1,
  "id": "personnel-info",
  "systemId": "flight-portal",
  "name": "飞行人员信息查询接口",
  "description": "按员工号读取基础信息、技术等级、运行资格、培训记录和训练经历；不读取训练历史记录。",
  "baseUrl": "https://ieb.csair.com",
  "navigationUrl": "https://ieb.csair.com/index/index#panel-1",
  "cookies": [
    { "name": "JSESSIONID", "required": true, "description": "门户 Session Cookie，HttpOnly" },
    { "name": "iebJSid", "required": true, "description": "IEB 会话 Cookie，HttpOnly" }
  ],
  "commonHeaders": [
    { "name": "Accept", "value": "text/html, */*; q=0.01", "description": "门户 HTML/XHR 响应" },
    { "name": "Referer", "value": "https://ieb.csair.com/index/index", "description": "已验证请求来源" },
    { "name": "X-Requested-With", "value": "XMLHttpRequest", "description": "门户 XHR 标记" }
  ],
  "groups": [
    { "id": "basic", "name": "基础信息" },
    { "id": "technical", "name": "技术等级" },
    { "id": "operation", "name": "运行资格" },
    { "id": "training", "name": "训练检查记录" }
  ],
  "endpoints": [
    { "id": "basic", "groupId": "basic", "name": "基础信息", "summary": "返回基本信息、教育经历、工作经历、职称信息和家庭信息五个分区。", "risk": "read", "method": "POST", "path": "/newieb/hrInfo/showEmpInfo", "requestEncoding": "multipart/form-data", "headers": [{ "name": "Accept", "value": "application/json, text/javascript, */*; q=0.01", "description": "基础信息 JSON 响应" }], "parameters": [{ "name": "staffNum", "in": "form", "label": "员工号", "type": "text", "required": true, "placeholder": "六位员工号" }], "response": { "format": "JSON", "statuses": [{ "code": 200, "description": "JSON；empDto、eduList、workList、titleList、relationList，列表为空是合法业务结果" }], "fields": [{ "name": "empDto", "type": "object", "description": "基本信息" }, { "name": "eduList", "type": "array", "description": "教育经历" }, { "name": "workList", "type": "array", "description": "工作经历" }, { "name": "titleList", "type": "array", "description": "职称信息" }, { "name": "relationList", "type": "array", "description": "家庭信息" }] } },
    { "id": "technical", "groupId": "technical", "name": "技术等级", "summary": "返回员工全部技术等级表格。", "risk": "read", "method": "POST", "path": "/newieb/basics/qualList", "parameters": [{ "name": "staffNum", "in": "form", "label": "员工号", "type": "text", "required": true }, { "name": "currentStr", "in": "form", "label": "防缓存参数", "type": "text", "auto": "timestamp", "fixed": true }], "response": { "format": "HTML table", "statuses": [{ "code": 200, "description": "#qualList；表头固定为 9 列" }], "fields": [{ "name": "技术等级代码", "type": "string" }, { "name": "技术等级", "type": "string" }, { "name": "机型", "type": "string" }, { "name": "生效时间", "type": "date" }, { "name": "失效时间", "type": "date" }] } },
    { "id": "operation", "groupId": "operation", "name": "运行资格", "summary": "返回员工全部运行资格表格。", "risk": "read", "method": "POST", "path": "/newieb/basics/showSingleEmpOperQualListByempIdNew", "parameters": [{ "name": "empid", "in": "form", "label": "员工号", "type": "text", "required": true }, { "name": "currentStr", "in": "form", "label": "防缓存参数", "type": "text", "auto": "timestamp", "fixed": true }], "response": { "format": "HTML table", "statuses": [{ "code": 200, "description": "#showSingleEmpOperQualList；表头固定为 8 列，需展开 rowspan/colspan" }], "fields": [{ "name": "运行资格代码", "type": "string" }, { "name": "运行资格", "type": "string" }, { "name": "机型", "type": "string" }, { "name": "生效时间", "type": "date" }] } },
    { "id": "training-records", "groupId": "training", "name": "培训记录", "summary": "每页最多 12 条，必须从第 1 页遍历到末页；超过末页会重复末页。", "risk": "read", "method": "POST", "path": "/newieb/basics/trainingRecordList", "parameters": [{ "name": "page", "in": "form", "label": "页码", "type": "number", "required": true, "default": "1" }, { "name": "staffId", "in": "form", "label": "员工号", "type": "text", "required": true }, { "name": "fuzzyQuery", "in": "form", "label": "模糊查询", "type": "text", "default": "true", "fixed": true }, { "name": "newMachineId", "in": "form", "label": "机型筛选", "type": "text", "default": "", "fixed": true }, { "name": "trainName", "in": "form", "label": "培训科目", "type": "text", "default": "", "fixed": true }], "response": { "format": "HTML table", "statuses": [{ "code": 200, "description": "#showTrainingRecordListDiv；培训记录表格与分页链接" }], "fields": [{ "name": "培训科目", "type": "string" }, { "name": "培训时间", "type": "date" }, { "name": "训练结果", "type": "string" }, { "name": "来源页码", "type": "number", "description": "客户端追加" }] } },
    { "id": "training-experiences", "groupId": "training", "name": "训练经历", "summary": "一次返回当前员工全部训练经历，不分页；不读取历史记录。", "risk": "read", "method": "POST", "path": "/newieb/basics/trainResultList", "parameters": [{ "name": "staffNum", "in": "form", "label": "员工号", "type": "text", "required": true }, { "name": "trainName", "in": "form", "label": "培训科目", "type": "text", "default": "", "fixed": true }], "response": { "format": "HTML table", "statuses": [{ "code": 200, "description": "#trainResultList；一次返回全部训练经历" }], "fields": [{ "name": "训练日期", "type": "date" }, { "name": "训练机型", "type": "string" }, { "name": "训练科目", "type": "string" }, { "name": "结论", "type": "string" }] } }
  ],
  "internalRequests": [],
  "technicalNotes": ["当前真实请求未观察到 CSRF、__VIEWSTATE、动态签名或 Authorization。", "HTTP 200 仍需判断登录页、容器、表头和员工归属。", "真实验证使用授权员工和当次 Cookie，脱敏结论不写入目录。"]
}
